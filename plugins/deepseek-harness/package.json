{
  "name": "dsh-plugin-pine-computer",
  "version": "0.1.0",
  "description": "Gives a DeepSeek Harness agent a Pine Computer: a cloud computer with its own agent that takes a job in plain words and returns finished work.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./skill": "./lib/skill.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cli.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@pinesandbox/computer": "^0.3.5",
    "@pinesandbox/computer-web": "^0.3.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-error": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.2",
    "@deepseek-ai/dsh-error": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}

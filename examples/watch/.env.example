# Copy to .env.local and fill in.

# Your project's endpoint and API key, from the console: Project → API keys.
PINE_SANDBOX_ENDPOINT=https://pinesandbox.io
PINE_SANDBOX_API_KEY=pk_...

# Encrypts the Computer's credentials, binding and session token at rest.
# Generate one with: openssl rand -base64 32
WATCH_SECRET=

# Optional: where the app keeps its records and the pictures of each check (default .data/).
# WATCH_DATA_DIR=

# Copy to .env.local and fill in.

# Your project's endpoint and API key, from the console: Project → API keys.
PINE_SANDBOX_ENDPOINT=https://pinesandbox.io
PINE_SANDBOX_API_KEY=pk_...

# Encrypts each reader's Computer credentials, binding and session token at rest.
# Generate one with: openssl rand -base64 32
CARREL_SECRET=

# Optional: where the app keeps its records and the screens its readers saw (default .data/).
# CARREL_DATA_DIR=

# Optional: how long a reader's Computer may sit idle before it stops itself (default 600).
# CARREL_IDLE_SECONDS=

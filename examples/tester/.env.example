# Copy to .env.local and fill in.

# Your project's endpoint and API key, from the console: Project → API keys.
PINE_SANDBOX_ENDPOINT=https://pinesandbox.io
PINE_SANDBOX_API_KEY=pk_...

# Encrypts the Computer's credentials and binding and each run's session token at rest.
# Generate one with: openssl rand -base64 32
TESTER_SECRET=

# Optional: where the app keeps its records and the screens it saved (default .data/).
# TESTER_DATA_DIR=

# Optional: how long the Computer may sit idle before it stops itself (default 300).
# TESTER_IDLE_SECONDS=

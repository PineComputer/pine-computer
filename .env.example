# Copy to .env.local and fill in.

# Pine Computer: your project's endpoint and API key, from the console (Project → API keys).
PINE_SANDBOX_ENDPOINT=https://pinesandbox.io
PINE_SANDBOX_API_KEY=pk_...

# Encrypts the Computer's credentials, binding and session token at rest: openssl rand -base64 32
DEMO_SECRET=

# Tavus: an API key (PAL Maker → API keys). `npm run setup:tavus` creates the tools and the PAL and prints
# TAVUS_PAL_ID. Set TAVUS_FACE_ID to a stock face before running it (docs.tavus.io → Stock Faces).
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_PAL_ID=

# The Larkspur Care test portal (portal/, a Cloudflare Worker). The staff key verifies claims and resets the demo.
PORTAL_URL=https://larkspur-care-demo.19pine.workers.dev
PORTAL_EMAIL=jordan.lee@example.com
PORTAL_PASSWORD=AeroPure-2026
PORTAL_STAFF_KEY=

# How long the Computer stays up without work, so a question can wait across a call-back (capped by the project).
DEMO_IDLE_TIMEOUT_SECONDS=3600

# Optional, for `npm run voice`: the customer's lines as clips, for recording a film (`npm run record`).
ELEVENLABS_API_KEY=

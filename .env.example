# Copy to .env.local and fill in.

# Your Pine project's endpoint and API key: every resident's home is a Pine Computer.
PINE_SANDBOX_ENDPOINT=https://pinesandbox.io
PINE_SANDBOX_API_KEY=pk_...

# Seals the homes' credentials and tokens at rest. Generate one with:
# openssl rand -base64 32
HABITAT_SECRET=

# Optional: where the habitat keeps its database and files (default .data/).
# HABITAT_DATA_DIR=

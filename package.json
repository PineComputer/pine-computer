{
  "name": "pine-computer",
  "version": "0.1.0",
  "description": "Pine Computer for the agent you already use: a cloud computer with an agent built in, as a tool (MCP, A2A), a coworker (ACP) and a CLI.",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "acp": "node dist/cli.js acp",
    "run": "node dist/cli.js run",
    "viewer": "node dist/cli.js viewer"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@ag-ui/core": "^1.0.4",
    "@ag-ui/encoder": "^1.0.4",
    "@agentclientprotocol/sdk": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pinesandbox/computer": "^0.3.5",
    "@pinesandbox/computer-web": "^0.3.8",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ag-ui/client": "^1.0.4",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "bin": {
    "pine-computer": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
